<Window x:Class="LyricsApp.StreamerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LyricsApp"
        Title="{local:Loc MainWindowTitle}"
        Icon="/LyricsApp.ico"
        Width="460" Height="640"
        WindowStyle="None" ResizeMode="NoResize" Background="Transparent" ShowActivated="False"
        Topmost="{Binding Display.Topmost}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True">
    <!--
        Streamer mode: song name, artist and lyrics on a transparent window, made for window capture (OBS and the like).
        Unlike the main window this one does not use AllowsTransparency: capture programs that copy the window with
        BitBlt get a black picture from such windows. Transparency comes from the desktop compositor instead, and every
        click goes through to whatever is behind (see the code-behind). The move and leave buttons live in their own
        small window, StreamerControls, so they can be clicked and stay out of the captured picture.
    -->
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <local:LyricsView x:Name="Lyrics" Grid.Row="1" IsHitTestVisible="False" Focusable="False" />

        <TextBlock Grid.Row="1" Text="{Binding Status}" Foreground="{StaticResource SecondaryText}" FontSize="14"
                   TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24"
                   Visibility="{Binding HasStatus, Converter={StaticResource BoolToVisibility}}" />

        <!-- Song card: artwork, title, artist. Nothing to click. -->
        <Border Grid.Row="0" Padding="12,10" CornerRadius="10" Background="{StaticResource HeaderBackground}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Width="52" Height="52" CornerRadius="6" Background="#FF2A2A32" ClipToBounds="True">
                    <Grid>
                        <TextBlock Text="&#xE8D6;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="22"
                                   Foreground="{StaticResource DimText}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                    </Grid>
                </Border>

                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" Foreground="{StaticResource PrimaryText}" FontSize="15" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Artist}" Foreground="{StaticResource SecondaryText}" FontSize="13"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
