<UserControl x:Class="LyricsApp.ColorField"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Self">
    <StackPanel>
        <ItemsControl x:Name="Swatches">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Width="22" Height="22" Margin="0,0,6,6" Cursor="Hand" Tag="{Binding}" Click="OnSwatchClick"
                            ToolTip="{Binding}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" CornerRadius="11" BorderThickness="2" BorderBrush="#33FFFFFF" Background="{Binding}" />
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="BorderBrush" Value="White" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <StackPanel Orientation="Horizontal">
            <Border Width="22" Height="22" CornerRadius="4" BorderThickness="1" BorderBrush="#55FFFFFF" Margin="0,0,8,0">
                <Border.Background>
                    <SolidColorBrush x:Name="Preview" Color="White" />
                </Border.Background>
            </Border>
            <TextBox x:Name="HexBox" Width="96" Padding="4,2" VerticalContentAlignment="Center"
                     Background="#FF2A2A32" Foreground="#FFF2F2F5" BorderBrush="#44FFFFFF" CaretBrush="White"
                     FontFamily="Consolas" ToolTip="#AARRGGBB veya #RRGGBB"
                     LostFocus="OnHexCommitted" KeyDown="OnHexKeyDown" />
        </StackPanel>
    </StackPanel>
</UserControl>
