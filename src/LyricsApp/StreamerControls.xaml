<Window x:Class="LyricsApp.StreamerControls"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LyricsApp"
        Title="{local:Loc MainWindowTitle}"
        Width="48" Height="26"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        ShowInTaskbar="False" ShowActivated="False" WindowStartupLocation="Manual"
        Topmost="{Binding Display.Topmost}"
        UseLayoutRounding="True">
    <!-- The only clickable part of streamer mode: move and leave. Shown by StreamerWindow while the mouse is over it. -->
    <Border Padding="2" CornerRadius="6" Background="#E61E1E24">
        <StackPanel Orientation="Horizontal">
            <Button Style="{StaticResource ToolButton}" Content="&#xE7C2;" Width="22" Height="22" FontSize="11" Cursor="SizeAll"
                    ToolTip="{local:Loc StreamerMove}" AutomationProperties.Name="{local:Loc StreamerMove}"
                    AutomationProperties.AutomationId="StreamerMoveButton" PreviewMouseLeftButtonDown="OnMoveMouseDown" />
            <Button Style="{StaticResource ToolButton}" Content="&#xE73F;" Width="22" Height="22" FontSize="11"
                    ToolTip="{local:Loc StreamerExit}" AutomationProperties.Name="{local:Loc StreamerExit}"
                    AutomationProperties.AutomationId="StreamerExitButton" Click="OnExitClick" />
        </StackPanel>
    </Border>
</Window>
