<Window x:Class="LyricsApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LyricsApp"
        Title="{local:Loc MainWindowTitle}"
        Icon="/LyricsApp.ico"
        Width="460" Height="640" MinWidth="240" MinHeight="120"
        WindowStyle="None" Background="Transparent" ResizeMode="CanMinimize"
        Topmost="{Binding Display.Topmost}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True">
    <!--
        No AllowsTransparency: capture programs that copy a window with BitBlt (the default in OBS) get a black picture
        from such windows. Transparency and click-through come from WindowSurface instead, so one and the same
        window serves the normal, lyrics-only and streamer modes and a capture stays attached across them.
    -->

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <local:BoolToCollapsedConverter x:Key="BoolToCollapsed" />

        <ContextMenu x:Key="WindowMenu">
            <MenuItem Header="{local:Loc AlwaysOnTop}" IsCheckable="True" IsChecked="{Binding Display.Topmost}" />
            <MenuItem Header="{local:Loc MenuLyricsOnly}" IsCheckable="True" IsChecked="{Binding Display.LyricsOnly}" />
            <MenuItem Header="{local:Loc MenuFocusMode}" IsCheckable="True" IsChecked="{Binding Display.FocusMode}" />
            <MenuItem Header="{local:Loc MenuLineFill}" IsCheckable="True" IsChecked="{Binding Display.LineFill}" />
            <MenuItem Header="{local:Loc MenuStreamerMode}" IsCheckable="True" IsChecked="{Binding Display.StreamerMode}" />
            <Separator />
            <MenuItem Header="{local:Loc RetrySearch}" Click="OnRetryClick" />
            <MenuItem Header="{local:Loc OpenLyricsFolder}" Click="OnOpenFolderClick" />
            <MenuItem Header="{local:Loc MenuSettings}" Click="OnSettingsClick" />
            <Separator />
            <MenuItem Header="{local:Loc Close}" Click="OnCloseClick" />
        </ContextMenu>
    </Window.Resources>

    <Grid x:Name="Root" ContextMenu="{StaticResource WindowMenu}"
          MouseEnter="OnRootMouseEnter" MouseLeave="OnRootMouseLeave">
        <Grid.Style>
            <Style TargetType="Grid">
                <!-- Nearly invisible fill keeps the whole window clickable/draggable. -->
                <Setter Property="Background" Value="#01000000" />
                <Style.Triggers>
                    <!-- Lyrics-only: no fill at all, so only the lines themselves take the mouse. The window lets
                         clicks through while the pointer is not on a letter (see the code-behind). -->
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding Display.LyricsOnly}" Value="True" />
                            <Condition Binding="{Binding IsChromeRevealed}" Value="False" />
                        </MultiDataTrigger.Conditions>
                        <Setter Property="Background" Value="{x:Null}" />
                        <Setter Property="Cursor" Value="Hand" />
                    </MultiDataTrigger>
                    <!-- Streamer mode: nothing to click at all, and a capture gets a fully transparent background. -->
                    <DataTrigger Binding="{Binding Display.StreamerMode}" Value="True">
                        <Setter Property="Background" Value="{x:Null}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Grid.Style>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Window background (opacity adjustable; in lyrics-only mode shown only after clicking the text) -->
        <Border Grid.RowSpan="2" CornerRadius="10" Background="{StaticResource WindowBackground}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Opacity" Value="{Binding Display.BackgroundOpacity}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Display.LyricsOnly}" Value="True">
                            <Setter Property="Opacity" Value="0" />
                        </DataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Display.LyricsOnly}" Value="True" />
                                <Condition Binding="{Binding IsChromeRevealed}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Opacity" Value="0.55" />
                        </MultiDataTrigger>
                        <!-- Streamer mode comes last in each style: it wins over lyrics-only. -->
                        <DataTrigger Binding="{Binding Display.StreamerMode}" Value="True">
                            <Setter Property="Opacity" Value="0" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
        </Border>

        <!-- Lyrics -->
        <local:LyricsView x:Name="Lyrics" Grid.Row="1">
            <local:LyricsView.Style>
                <Style TargetType="local:LyricsView">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Display.LyricsOnly}" Value="True">
                            <Setter Property="Grid.Row" Value="0" />
                            <Setter Property="Grid.RowSpan" Value="2" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Display.StreamerMode}" Value="True">
                            <Setter Property="Grid.Row" Value="1" />
                            <Setter Property="Grid.RowSpan" Value="1" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </local:LyricsView.Style>
        </local:LyricsView>

        <TextBlock Grid.Row="1" Text="{Binding Status}" Foreground="{StaticResource SecondaryText}" FontSize="14"
                   TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24"
                   Visibility="{Binding HasStatus, Converter={StaticResource BoolToVisibility}}" />

        <!-- Header: artwork, title, tools. Hidden in lyrics-only mode until a line is clicked;
             streamer mode shows its own song card instead. -->
        <Border x:Name="Header" Grid.Row="0" Background="{StaticResource HeaderBackground}"
                Visibility="{Binding Display.StreamerMode, Converter={StaticResource BoolToCollapsed}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Opacity" Value="1" />
                    <Setter Property="Padding" Value="12,10,8,8" />
                    <Setter Property="CornerRadius" Value="10,10,0,0" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Display.LyricsOnly}" Value="True">
                            <Setter Property="Opacity" Value="0" />
                            <Setter Property="IsHitTestVisible" Value="False" />
                        </DataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Display.LyricsOnly}" Value="True" />
                                <Condition Binding="{Binding IsChromeRevealed}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Opacity" Value="1" />
                            <Setter Property="IsHitTestVisible" Value="True" />
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Width="52" Height="52" CornerRadius="6" Background="#FF2A2A32" ClipToBounds="True" VerticalAlignment="Top">
                    <Grid>
                        <TextBlock Text="&#xE8D6;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="22"
                                   Foreground="{StaticResource DimText}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                    </Grid>
                </Border>

                <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" Foreground="{StaticResource PrimaryText}" FontSize="15" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" />
                    <TextBlock Text="{Binding Artist}" Foreground="{StaticResource SecondaryText}" FontSize="13"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Artist}" />
                    <TextBlock Text="{Binding ProviderName}" Foreground="{StaticResource DimText}" FontSize="11"
                               TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <ToggleButton Style="{StaticResource ToolToggle}" Content="&#xE718;" ToolTip="{local:Loc AlwaysOnTop}" AutomationProperties.Name="{local:Loc AlwaysOnTop}"
                                      IsChecked="{Binding Display.Topmost}" />
                        <ToggleButton Style="{StaticResource ToolToggle}" Content="&#xE890;" ToolTip="{local:Loc ToolLyricsOnly}" AutomationProperties.Name="{local:Loc ToolLyricsOnly}"
                                      IsChecked="{Binding Display.LyricsOnly}" />
                        <ToggleButton Style="{StaticResource ToolToggle}" Content="&#xE8FD;" ToolTip="{local:Loc ToolFocusMode}" AutomationProperties.Name="{local:Loc ToolFocusMode}"
                                      IsChecked="{Binding Display.FocusMode}" />
                        <Button Style="{StaticResource ToolButton}" Content="&#xE713;" ToolTip="{local:Loc Settings}" AutomationProperties.Name="{local:Loc Settings}"
                                AutomationProperties.AutomationId="SettingsButton" Click="OnSettingsClick" />
                        <Button Style="{StaticResource ToolButton}" Content="&#xE921;" ToolTip="{local:Loc Minimize}" AutomationProperties.Name="{local:Loc Minimize}" Click="OnMinimizeClick" />
                        <Button Style="{StaticResource ToolButton}" Content="&#xE8BB;" ToolTip="{local:Loc Close}" AutomationProperties.Name="{local:Loc Close}" Click="OnCloseClick" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <ToggleButton Style="{StaticResource ToolToggle}" Content="&#xE93E;" Height="24" ToolTip="{local:Loc ToolStreamerMode}" AutomationProperties.Name="{local:Loc ToolStreamerMode}"
                                      AutomationProperties.AutomationId="StreamerModeButton" IsChecked="{Binding Display.StreamerMode}" />
                        <Button Style="{StaticResource ToolButton}" Content="&#xE72C;" Height="24" ToolTip="{local:Loc RetrySearch}" AutomationProperties.Name="{local:Loc RetrySearch}" Click="OnRetryClick" />
                        <Button Style="{StaticResource ToolButton}" Content="&#xE838;" Height="24" ToolTip="{local:Loc OpenLyricsFolder}" AutomationProperties.Name="{local:Loc OpenLyricsFolder}" Click="OnOpenFolderClick" />
                        <StackPanel Orientation="Horizontal" Visibility="{Binding IsSynced, Converter={StaticResource BoolToVisibility}}">
                            <Button Style="{StaticResource ToolButton}" Content="&#xE738;" Height="24" ToolTip="{local:Loc OffsetMinus}" AutomationProperties.Name="{local:Loc OffsetMinus}" Click="OnOffsetMinusClick" />
                            <TextBlock x:Name="OffsetLabel" Text="{Binding OffsetText}" Foreground="{StaticResource SecondaryText}" FontSize="11"
                                       MinWidth="44" TextAlignment="Center" VerticalAlignment="Center" Cursor="Hand"
                                       ToolTip="{local:Loc OffsetLabelToolTip}" MouseLeftButtonUp="OnOffsetResetClick" />
                            <Button Style="{StaticResource ToolButton}" Content="&#xE710;" Height="24" ToolTip="{local:Loc OffsetPlus}" AutomationProperties.Name="{local:Loc OffsetPlus}" Click="OnOffsetPlusClick" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <local:StreamerCard Grid.Row="0" Visibility="{Binding Display.StreamerMode, Converter={StaticResource BoolToVisibility}}" />

        <!-- Resize edges: the window has no frame of its own. Hidden in the modes that let clicks through. -->
        <Grid x:Name="ResizeGrips" Grid.RowSpan="2"
              MouseLeftButtonDown="OnResizeMouseDown" MouseMove="OnResizeMouseMove" MouseLeftButtonUp="OnResizeMouseUp">
            <Rectangle Tag="Left" Width="6" HorizontalAlignment="Left" Fill="Transparent" Cursor="SizeWE" />
            <Rectangle Tag="Right" Width="6" HorizontalAlignment="Right" Fill="Transparent" Cursor="SizeWE" />
            <Rectangle Tag="Top" Height="6" VerticalAlignment="Top" Fill="Transparent" Cursor="SizeNS" />
            <Rectangle Tag="Bottom" Height="6" VerticalAlignment="Bottom" Fill="Transparent" Cursor="SizeNS" />
            <Rectangle Tag="TopLeft" Width="10" Height="10" HorizontalAlignment="Left" VerticalAlignment="Top" Fill="Transparent" Cursor="SizeNWSE" />
            <Rectangle Tag="TopRight" Width="10" Height="10" HorizontalAlignment="Right" VerticalAlignment="Top" Fill="Transparent" Cursor="SizeNESW" />
            <Rectangle Tag="BottomLeft" Width="10" Height="10" HorizontalAlignment="Left" VerticalAlignment="Bottom" Fill="Transparent" Cursor="SizeNESW" />
            <Rectangle Tag="BottomRight" Width="10" Height="10" HorizontalAlignment="Right" VerticalAlignment="Bottom" Fill="Transparent" Cursor="SizeNWSE" />
        </Grid>
    </Grid>
</Window>
