<Window x:Class="LyricsApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Şarkı Sözleri"
        Width="460" Height="640" MinWidth="300" MinHeight="260"
        Background="{StaticResource WindowBackground}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header: artwork, title, artist, tools -->
        <Border Background="{StaticResource HeaderBackground}" Padding="12,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Width="52" Height="52" CornerRadius="6" Background="#FF2A2A32" ClipToBounds="True">
                    <Grid>
                        <TextBlock Text="&#xE8D6;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="22"
                                   Foreground="{StaticResource DimText}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                    </Grid>
                </Border>

                <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" Foreground="{StaticResource PrimaryText}" FontSize="15" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" />
                    <TextBlock Text="{Binding Artist}" Foreground="{StaticResource SecondaryText}" FontSize="13"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Artist}" />
                    <TextBlock Text="{Binding ProviderName}" Foreground="{StaticResource DimText}" FontSize="11"
                               TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource ToolButton}" Content="&#xE72C;" ToolTip="Sözleri yeniden ara" Click="OnRetryClick" />
                        <Button Style="{StaticResource ToolButton}" Content="&#xE838;" ToolTip="Söz klasörünü aç" Click="OnOpenFolderClick" />
                        <ToggleButton x:Name="TopmostToggle" Style="{StaticResource ToolToggle}" Content="&#xE718;"
                                      ToolTip="Her zaman üstte" Click="OnTopmostClick" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                Visibility="{Binding IsSynced, Converter={StaticResource BoolToVisibility}}">
                        <Button Style="{StaticResource ToolButton}" Content="&#xE738;" Height="24" ToolTip="Sözleri geciktir (−0,5 sn)" Click="OnOffsetMinusClick" />
                        <TextBlock Text="{Binding OffsetText}" Foreground="{StaticResource SecondaryText}" FontSize="11"
                                   MinWidth="44" TextAlignment="Center" VerticalAlignment="Center" Cursor="Hand"
                                   ToolTip="Zaman kaydırma (sıfırlamak için tıklayın)" MouseLeftButtonUp="OnOffsetResetClick" />
                        <Button Style="{StaticResource ToolButton}" Content="&#xE710;" Height="24" ToolTip="Sözleri öne al (+0,5 sn)" Click="OnOffsetPlusClick" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Lyrics -->
        <ScrollViewer x:Name="LyricsScroller" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      PreviewMouseWheel="OnLyricsUserScroll" PreviewMouseDown="OnLyricsUserScroll">
            <ItemsControl x:Name="LyricsList" ItemsSource="{Binding Lines}" Margin="20,24">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock x:Name="Line" Text="{Binding Text}" TextWrapping="Wrap" TextAlignment="Center"
                                   FontSize="18" Margin="0,5" Foreground="{StaticResource PrimaryText}" />
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding DataContext.IsSynced, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                <Setter TargetName="Line" Property="Foreground" Value="{StaticResource DimText}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                <Setter TargetName="Line" Property="Foreground" Value="{StaticResource PrimaryText}" />
                                <Setter TargetName="Line" Property="FontWeight" Value="SemiBold" />
                                <Setter TargetName="Line" Property="FontSize" Value="22" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <TextBlock Grid.Row="1" Text="{Binding Status}" Foreground="{StaticResource SecondaryText}" FontSize="14"
                   TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24"
                   Visibility="{Binding HasStatus, Converter={StaticResource BoolToVisibility}}" />
    </Grid>
</Window>
