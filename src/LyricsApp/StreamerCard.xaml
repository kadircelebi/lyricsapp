<UserControl x:Class="LyricsApp.StreamerCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             IsHitTestVisible="False" Focusable="False">
    <!--
        The song card of streamer mode: artwork, title, artist, and how far the song has played.
        The artwork, blurred and darkened, is also the card's backdrop. DataContext: MainViewModel.
    -->
    <Grid>
        <!-- The card's shape; also the mask that keeps the backdrop inside the rounded corners. -->
        <Border x:Name="Shape" CornerRadius="14" Background="{StaticResource HeaderBackground}" />

        <Grid ClipToBounds="True">
            <Grid.OpacityMask>
                <VisualBrush Visual="{Binding ElementName=Shape}" Stretch="None" />
            </Grid.OpacityMask>
            <!-- Larger than the card, so the soft edge of the blur falls outside it. Drawn once per song.
                 A brush, not an Image: an image would ask for its own height and stretch the card. -->
            <Border Margin="-48" Opacity="0.7">
                <Border.Background>
                    <ImageBrush ImageSource="{Binding Thumbnail}" Stretch="UniformToFill" />
                </Border.Background>
                <Border.Effect>
                    <BlurEffect Radius="56" KernelType="Gaussian" RenderingBias="Performance" />
                </Border.Effect>
            </Border>
            <!-- Darker on the text side, so the words stay readable on any artwork. -->
            <Border>
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#8014141A" Offset="0" />
                        <GradientStop Color="#BF14141A" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
        </Grid>

        <Border CornerRadius="14" BorderBrush="#24FFFFFF" BorderThickness="1" />

        <Grid Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Artwork with rounded corners; the note shows through while there is none. -->
            <Grid Width="64" Height="64">
                <Border CornerRadius="10" Background="#FF2A2A32">
                    <TextBlock Text="&#xE8D6;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="26"
                               Foreground="{StaticResource DimText}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <Rectangle RadiusX="10" RadiusY="10">
                    <Rectangle.Fill>
                        <ImageBrush ImageSource="{Binding Thumbnail}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                    </Rectangle.Fill>
                </Rectangle>
                <Border CornerRadius="10" BorderBrush="#29FFFFFF" BorderThickness="1" />
            </Grid>

            <StackPanel Grid.Column="1" Margin="14,0,2,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding Title}" Foreground="{StaticResource PrimaryText}" FontSize="16" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Artist}" Foreground="#CCF2F2F5" FontSize="13" TextTrimming="CharacterEllipsis" />

                <!-- Elapsed time, progress, length. Not shown when the player reports no length or the option is off. -->
                <Grid Margin="0,7,0,0">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding Display.StreamerProgress}" Value="True" />
                                        <Condition Binding="{Binding HasSongProgress}" Value="True" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding SongPositionText}" Foreground="#B8F2F2F5" FontSize="11" VerticalAlignment="Center"
                               Typography.NumeralAlignment="Tabular" AutomationProperties.AutomationId="SongPositionText" />
                    <ProgressBar Grid.Column="1" Height="4" Margin="8,1,8,0" VerticalAlignment="Center"
                                 Minimum="0" Maximum="1" Value="{Binding SongProgress, Mode=OneWay}"
                                 Foreground="{Binding Display.ActiveBrush}" AutomationProperties.AutomationId="SongProgressBar">
                        <ProgressBar.Template>
                            <ControlTemplate TargetType="ProgressBar">
                                <Grid>
                                    <Border x:Name="PART_Track" Background="#38FFFFFF" CornerRadius="2" />
                                    <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="2" HorizontalAlignment="Left" />
                                </Grid>
                            </ControlTemplate>
                        </ProgressBar.Template>
                    </ProgressBar>
                    <TextBlock Grid.Column="2" Text="{Binding SongDurationText}" Foreground="#B8F2F2F5" FontSize="11" VerticalAlignment="Center"
                               Typography.NumeralAlignment="Tabular" AutomationProperties.AutomationId="SongDurationText" />
                </Grid>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
