<Window x:Class="LyricsApp.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LyricsApp"
        Title="{local:Loc DisplaySettings}"
        Icon="/LyricsApp.ico"
        Width="400" Height="720" MinWidth="340" MinHeight="300"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="CanResize"
        Background="{StaticResource WindowBackground}" Foreground="{StaticResource PrimaryText}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        Topmost="{Binding Topmost}">
    <Window.Resources>
        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource Accent}" />
            <Setter Property="Margin" Value="0,18,0,8" />
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SecondaryText}" />
            <Setter Property="Margin" Value="0,8,0,4" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
            <Setter Property="Margin" Value="0,4" />
        </Style>
        <Style TargetType="Slider">
            <Setter Property="IsSnapToTickEnabled" Value="False" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
        <Style x:Key="PresetButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
            <Setter Property="Background" Value="#FF2A2A32" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF3A3A44" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Hidden">
        <StackPanel Margin="20,4,20,20">

            <TextBlock Text="{local:Loc SectionWindow}" Style="{StaticResource Section}" />
            <CheckBox Content="{local:Loc AlwaysOnTop}" IsChecked="{Binding Topmost}" />
            <CheckBox IsChecked="{Binding LyricsOnly}">
                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource PrimaryText}" Text="{local:Loc SettingsLyricsOnly}" />
            </CheckBox>
            <TextBlock Style="{StaticResource Label}">
                <Run Text="{local:Loc BackgroundOpacity}" />
                <Run Text="{Binding BackgroundOpacity, StringFormat={}{0:P0}, Mode=OneWay}" />
            </TextBlock>
            <Slider Minimum="0" Maximum="1" SmallChange="0.05" LargeChange="0.1" Value="{Binding BackgroundOpacity}" />

            <TextBlock Text="{local:Loc SectionKaraoke}" Style="{StaticResource Section}" />
            <CheckBox IsChecked="{Binding FocusMode}">
                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource PrimaryText}" Text="{local:Loc SettingsFocusMode}" />
            </CheckBox>
            <TextBlock Style="{StaticResource Label}">
                <Run Text="{local:Loc ContextLines}" />
                <Run Text="{Binding ContextLines, Mode=OneWay}" />
            </TextBlock>
            <Slider Minimum="0" Maximum="6" IsSnapToTickEnabled="True" TickFrequency="1" Value="{Binding ContextLines}"
                    IsEnabled="{Binding FocusMode}" />
            <CheckBox IsChecked="{Binding LineFill}">
                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource PrimaryText}" Text="{local:Loc SettingsLineFill}" />
            </CheckBox>

            <TextBlock Text="{local:Loc SectionText}" Style="{StaticResource Section}" />
            <TextBlock Text="{local:Loc Presets}" Style="{StaticResource Label}" />
            <WrapPanel>
                <Button Style="{StaticResource PresetButton}" Content="{local:Loc PresetClassic}" Tag="classic" Click="OnPresetClick" />
                <Button Style="{StaticResource PresetButton}" Content="{local:Loc PresetKaraoke}" Tag="karaoke" Click="OnPresetClick" />
                <Button Style="{StaticResource PresetButton}" Content="{local:Loc PresetNeon}" Tag="neon" Click="OnPresetClick" />
                <Button Style="{StaticResource PresetButton}" Content="{local:Loc PresetPlain}" Tag="plain" Click="OnPresetClick" />
            </WrapPanel>

            <TextBlock Text="{local:Loc Font}" Style="{StaticResource Label}" />
            <ComboBox x:Name="FontBox" IsEditable="True" Text="{Binding FontFamily, UpdateSourceTrigger=LostFocus}" />

            <TextBlock Style="{StaticResource Label}">
                <Run Text="{local:Loc ActiveLineSize}" />
                <Run Text="{Binding FontSize, StringFormat={}{0:0}, Mode=OneWay}" />
            </TextBlock>
            <Slider Minimum="12" Maximum="72" SmallChange="1" LargeChange="4" Value="{Binding FontSize}" />

            <TextBlock Text="{local:Loc ActiveLineColor}" Style="{StaticResource Label}" />
            <local:ColorField Value="{Binding ActiveColor}" />

            <TextBlock Text="{local:Loc InactiveLineColor}" Style="{StaticResource Label}" />
            <local:ColorField Value="{Binding InactiveColor}" />

            <TextBlock Text="{local:Loc SectionShadow}" Style="{StaticResource Section}" />
            <CheckBox Content="{local:Loc ShadowEnabled}" IsChecked="{Binding ShadowEnabled}" />
            <StackPanel IsEnabled="{Binding ShadowEnabled}">
                <TextBlock Text="{local:Loc ShadowColor}" Style="{StaticResource Label}" />
                <local:ColorField Value="{Binding ShadowColor}" />
                <TextBlock Style="{StaticResource Label}">
                    <Run Text="{local:Loc ShadowBlur}" />
                    <Run Text="{Binding ShadowBlur, StringFormat={}{0:0}, Mode=OneWay}" />
                </TextBlock>
                <Slider Minimum="0" Maximum="40" SmallChange="1" Value="{Binding ShadowBlur}" />
                <TextBlock Style="{StaticResource Label}">
                    <Run Text="{local:Loc ShadowDepth}" />
                    <Run Text="{Binding ShadowDepth, StringFormat={}{0:0}, Mode=OneWay}" />
                    <Run Text="{local:Loc ShadowDepthHint}" Foreground="{StaticResource DimText}" />
                </TextBlock>
                <Slider Minimum="0" Maximum="12" SmallChange="1" Value="{Binding ShadowDepth}" />
                <TextBlock Style="{StaticResource Label}">
                    <Run Text="{local:Loc ShadowOpacity}" />
                    <Run Text="{Binding ShadowOpacity, StringFormat={}{0:P0}, Mode=OneWay}" />
                </TextBlock>
                <Slider Minimum="0" Maximum="1" SmallChange="0.05" Value="{Binding ShadowOpacity}" />
            </StackPanel>

            <TextBlock Text="{local:Loc SectionRecognition}" Style="{StaticResource Section}" />
            <CheckBox x:Name="RecognizeBox">
                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource PrimaryText}" Text="{local:Loc SettingsRecognizeUnfound}" />
            </CheckBox>
            <TextBlock TextWrapping="Wrap" Margin="22,2,0,0" FontSize="12" Foreground="{StaticResource DimText}"
                       Text="{local:Loc RecognizeUnfoundHint}" />
        </StackPanel>
    </ScrollViewer>
</Window>
